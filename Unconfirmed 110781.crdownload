from turtle import Turtle
tom = Turtle()
tom.shape('turtle')
tom.color('darkblue')
# background
tom.speed(0)
tom.penup()
tom.goto(-640,325)
tom.pendown()
tom.begin_fill()
tom.right(90)
tom.forward(1050)
tom.left(90)
tom.forward(1400)
tom.left(90)
tom.forward(1050)
tom.left(90)
tom.forward(1400)
tom.end_fill()

# Firework
def Firework():
    for i in range(18):
        tom.pensize(3)
        tom.penup()
        tom.forward(20)
        tom.color('gold')
        tom.pendown()
        tom.forward(30)
        tom.penup()
        tom.forward(10)
        tom.color('white')
        tom.pendown()
        tom.forward(30)
        tom.penup()
        tom.forward(10)
        tom.color('orange')
        tom.pendown()
        tom.forward(30)
        tom.penup()
        tom.forward(-130)
        tom.right(20)
tom.penup()
tom.goto(-600,170)
Firework()
tom.penup()
tom.goto(-300,200)
Firework()
tom.penup()
tom.goto(0,150)
Firework()
tom.penup()
tom.goto(300,230)
Firework()
tom.penup()
tom.goto(600,170)
Firework()

